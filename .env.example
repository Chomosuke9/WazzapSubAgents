# ============================================================================
# Service configuration and credentials
# Copy to .env and edit as needed.
# For secrets (API keys), copy .env.secrets.example to .env.secrets.
# ============================================================================

# Service
FLASK_PORT=5000
# Localhost port published by the single Docker sandbox managed by main.py.
EXECUTOR_PORT=5001
# HTTP timeout is execution timeout plus this response-delivery grace period.
EXECUTOR_HTTP_TIMEOUT_GRACE=15
# Shared main-service -> executor credential. Use a long random value.
EXECUTOR_API_TOKEN=replace-with-a-long-random-token
EXECUTOR_REQUIRE_AUTH=1
# Parent WazzapAgents -> this receiver. Use a distinct long random token and
# configure the same SUBAGENT_API_TOKEN on WazzapAgents.
SUBAGENT_API_TOKEN=replace-with-a-different-long-random-token
SUBAGENT_REQUIRE_API_AUTH=1
# This receiver -> WazzapAgents callback authentication. Keep separate from
# SUBAGENT_API_TOKEN and configure the same value on WazzapAgents.
SUBAGENT_WEBHOOK_TOKEN=replace-with-another-long-random-token
# Optional host directory for session workdirs. It is translated to the fixed
# /storage/subagent_work path inside the sandbox. Defaults to
# <repo>/.runtime/subagent_work on the host.
# WORKDIR_BASE=/srv/wazzapsubagents/work
# Comma-separated skill variables exposed to generated commands. Service
# credentials such as EXECUTOR_API_TOKEN are always blocked.
# EXECUTOR_TOOL_ENV_PASSTHROUGH=BRAVE_SEARCH_API_KEY,NINEROUTER_URL,NINEROUTER_KEY
SESSION_IDLE_TIMEOUT=7200
LOG_LEVEL=INFO

# Webhook delivery — WazzapAgents' webhook server is always-on (auto-
# restarts on crash), so transient failures are expected to resolve fast.
# These control retry aggressiveness and the pre-flight health check.
# WEBHOOK_RETRY_MAX=15
# WEBHOOK_RETRY_BASE_BACKOFF=1.0
# WEBHOOK_RETRY_MAX_BACKOFF=60.0
# WEBHOOK_HEALTH_CHECK_ATTEMPTS=5
# WEBHOOK_HEALTH_CHECK_TIMEOUT=15.0

# Maximum file size (bytes) to inline as base64 in the webhook callback.
# Larger outputs are exposed through an authenticated checksum-verified
# download URL instead of an unusable cross-machine local path.
# SUBAGENT_MAX_INLINE_FILE_BYTES=52428800
# SUBAGENT_MAX_INLINE_TOTAL_BYTES=134217728
# Resumable cross-machine input upload limits (defaults: 200 MiB per file,
# 512 MiB aggregate active uploads, 8 MiB per chunk).
# SUBAGENT_MAX_UPLOAD_FILE_BYTES=209715200
# SUBAGENT_MAX_UPLOAD_TOTAL_BYTES=536870912
# SUBAGENT_MAX_UPLOAD_CHUNK_BYTES=8388608
# SUBAGENT_UPLOAD_INCOMPLETE_TTL_S=900
# SUBAGENT_UPLOAD_COMPLETE_TTL_S=3600

# Global concurrency limit for sub-agent sessions. At most this many
# sessions may run their agent loop simultaneously; additional sessions
# wait in a FIFO queue before any LLM call or tool execution.
# Default 1. Set to 0 or negative to clamp to 1.
# SUBAGENT_GLOBAL_LIMIT=1

# LLM (supports OpenAI-compatible endpoints)
LLM_API_KEY=sk-...
# Agent model for routine tasks (default when high_quality=false)
AGENT_MODEL_LOW=gpt-4-turbo
# Agent model for complex tasks requiring deeper reasoning (used when high_quality=true)
# Falls back to AGENT_MODEL_LOW if not set.
AGENT_MODEL_HIGH=o3
# LLM_BASE_URL=  # Optional: custom endpoint (e.g. https://api.openai.com/v1, http://localhost:11434/v1)
AGENT_TEMPERATURE_LOW=0.7
AGENT_TEMPERATURE_HIGH=0.3
# Maximum ReAct loop turns per task. Set 0 for unlimited iterations.
AGENT_MAX_ITERATIONS=50
