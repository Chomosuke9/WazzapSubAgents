# ============================================================================
# Secrets (API keys and tokens)
# Copy to .env.secrets and fill in real values.
# This file is loaded by the host service and is git-ignored. Only explicitly
# allowlisted skill values are forwarded into the Docker sandbox.
# ============================================================================

# Brave Search API key (required for internet-researcher skills)
BRAVE_SEARCH_API_KEY=

# 9Router connection settings. From Docker, use host.docker.internal for a
# 9Router instance running on the host machine.
NINEROUTER_URL=http://host.docker.internal:20128
# API key is required when REQUIRE_API_KEY=true.
NINEROUTER_KEY=

# Add other secrets below as needed.
